# Local development. `docker compose up -d db` publishes Postgres on 5435 —
# docker-compose.yml says why.
DATABASE_URL=postgres://habit:habit@localhost:5435/habit_tracker

# openssl rand -hex 32
BETTER_AUTH_SECRET=<32+ char random string>

BETTER_AUTH_URL=http://localhost:3000

# Optional — only when the browser must call a different origin than the one
# it is served from (a proxy in front with its own hostname). Otherwise the
# auth client derives its base URL from window.location.origin.
# NEXT_PUBLIC_BETTER_AUTH_URL=

# Optional — magic-link email delivery. Needed once magic-link sign-in is
# wired up; passkey sign-in does not use it.
RESEND_API_KEY=
EMAIL_FROM=auth@example.com
