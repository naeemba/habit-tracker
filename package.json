{
  "name": "habit-tracker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node --env-file-if-exists=.env node_modules/.bin/next-starter migrate && node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:backfill-ledger": "node --env-file-if-exists=.env scripts/backfill-ledger.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "db:generate": "node --env-file-if-exists=.env node_modules/.bin/drizzle-kit generate"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.15",
    "@naeemba/next-starter": "^0.13.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "postgres": "^4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "minimatch@^10": "^11.0.3"
  }
}
