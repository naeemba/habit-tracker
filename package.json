{
  "name": "habit-tracker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node --env-file-if-exists=.env node_modules/.bin/next-starter migrate && node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:backfill-ledger": "node --env-file-if-exists=.env scripts/backfill-ledger.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "db:generate": "node --env-file-if-exists=.env node_modules/.bin/drizzle-kit generate"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.5",
    "@naeemba/next-starter": "^0.12.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
